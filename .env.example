# FC 27 Market Engine — copy to backend/.env (or export in your shell) and adjust.
# Values shown are the defaults used when a variable is unset.

# --- Database -------------------------------------------------------------
# SQLite for local development:
DATABASE_URL=sqlite:///./fc27_market_engine.db
# PostgreSQL for deployments (pip install -r requirements-postgres.txt):
# DATABASE_URL=postgresql+psycopg://fc27:change-me@localhost:5432/fc27
# Run Alembic migrations automatically on startup.
AUTO_MIGRATE=true

# --- Accounts & auth --------------------------------------------------------
ALLOW_REGISTRATION=true
# "Try the demo account" creates a private, freshly seeded demo user per visitor.
ALLOW_DEMO_SIGNUP=true
# Also create a shared login: username "demo", password below. Disable in production.
SEED_DEMO_USER=true
DEMO_PASSWORD=demo-trader-27
SESSION_TTL_HOURS=168
PASSWORD_HASH_ITERATIONS=390000
# Comma-separated origins allowed to call the API from a browser (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Market data ------------------------------------------------------------
# none      = manual entry, CSV import and simulation only (default; no live prices assumed)
# http_json = an authorised provider you have permission to use — see docs/MARKET_DATA.md
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=10

# --- Serving the built frontend --------------------------------------------
# Defaults to ../frontend/dist relative to backend/ when it exists.
FRONTEND_DIST=
